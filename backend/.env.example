# Copiá este archivo como `.env` (en esta carpeta) y completá tus valores.
# El archivo `.env` no se sube al repositorio.

# Cadena de conexión a la base de desarrollo (PostgreSQL 18, instalado localmente).
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Reemplazá USUARIO y CONTRASEÑA por los de tu instalación local.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/utn_connect"
