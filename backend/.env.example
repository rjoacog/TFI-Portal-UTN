# Copiá este archivo como `.env` (en esta carpeta) y completá tus valores.
# El archivo `.env` no se sube al repositorio.
# La API valida estas variables al iniciar: si falta alguna o es inválida, no arranca y muestra cuál.

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Puerto en el que escucha la API. Si no se define, se usa 3000.
PORT=3000

# Cadena de conexión a la base de desarrollo (PostgreSQL 18, instalado localmente).
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Reemplazá USUARIO y CONTRASEÑA por los de tu instalación local.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/utn_connect"

# Conexión que usan las pruebas (`npm run test`). Es la misma que `DATABASE_URL`, con `?schema=test`
# al final: las pruebas usan el esquema `test` de la misma base y no tocan los datos de desarrollo
# (esquema `public`). La API no la valida al iniciar: la valida la preparación de las pruebas.
# Si falta o no indica `schema=test`, las pruebas no corren.
DATABASE_URL_TEST="postgresql://USUARIO:CONTRASEÑA@localhost:5432/utn_connect?schema=test"

# Orígenes permitidos para CORS, separados por comas.
# Cada uno es esquema, host y puerto, sin ruta ni barra final.
# En desarrollo es la dirección de la web (Vite).
CORS_ORIGINS=http://localhost:5173

# Secreto con el que se firman los tokens de sesión (JWT). Obligatorio, de al menos 32 caracteres.
# Generá uno al azar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Cambiarlo cierra todas las sesiones abiertas. Nunca se sube al repositorio.
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Primer administrador (lo crea `npm run db:seed`). Solo las usa el seed, no la API.
# Si falta alguna o es inválida, el seed termina con un mensaje. Si el loginId ya existe, no se duplica.
# La contraseña tiene al menos 8 caracteres y es temporal: el administrador la cambia al ingresar.
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=12345678

# Contraseña común de los usuarios de prueba (la usa `npm run db:seed:dev`). Solo para desarrollo.
# `db:seed:dev` no se ejecuta con NODE_ENV=production. Al menos 8 caracteres.
SEED_DEV_PASSWORD=desarrollo123
